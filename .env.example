# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=5000
# Comma-separated allow-list. Add every frontend origin (production + previews).
CLIENT_ORIGIN=http://localhost:5173

# MySQL / MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vitalis
# Managed providers (Aiven, Railway, PlanetScale, ...) usually need TLS.
DB_SSL=false
# Serverless: keep small (2-5). Local development: 12 is fine.
DB_POOL_SIZE=12

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=vitalis_token
# lax = frontend proxies /api (recommended). none = direct cross-site API calls.
COOKIE_SAMESITE=lax

# Optional OpenAI-compatible LLM (the assistant is unavailable until set)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Set by Vercel automatically; no need to define it there.
# VERCEL=1
